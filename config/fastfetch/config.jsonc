{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": null, // Auto-detects the original OS ASCII art natively
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": " • ",
    "color": {
      "keys": "blue",
      "title": "magenta"
    }
  },
  "modules": [
    "title",
    {
      "type": "os",
      "key": "os  "
    },
    {
      "type": "kernel",
      "key": "ker "
    },
    {
      "type": "uptime",
      "key": "up  "
    },
    {
      "type": "packages",
      "key": "pkg "
    },
    {
      "type": "shell",
      "key": "sh  "
    },
    {
      "type": "wm",
      "key": "wm  "
    },
    {
      "type": "terminal",
      "key": "term"
    },
    {
      "type": "font",
      "key": "font"
    },
    {
      "type": "memory",
      "key": "mem "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle" // Renders clean circular color accents instead of blocks
    }
  ]
}