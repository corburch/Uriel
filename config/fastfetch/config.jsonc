{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  
  "display": {
    "separator": "  → "
  },
  
  "modules": [
    {
        "type": "os",
        "key": "    ╭── "
    },
    {
        "type": "kernel",
        "key": "OS  ├── 󰏗"
    },
    {
        "type": "shell",
        "key": "    ╰── "
    },


    "break",


    {
        "type": "wm",
        "key": "    ╭── "
    },
    {
        "type": "wmtheme",
        "key": "WM  ├── "
    },
    {
        "type": "font",
        "key": "    ╰── "
    },




    "break",

    {
        "type": "host",
        "key": "    ╭── "
    },
    {
        "type": "cpu",
        "key": "    ├── 󰻠"
    },
    {
        "type": "gpu",
        "key": "    ├── 󰢮",
              "format": "{vendor} {type} ({core-count}) @ {frequency}"
    },
    {
        "type": "memory",
        "key": "PC  ├── "
    },
    {
        "type": "disk",
        "key": "    ├── 󰋊",
        "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
        "type": "wifi",
        "key": "    ├── 󰖩",
        "format": "{ssid} - {band} GHz - {security}"
    },
    {
        "type": "display",
        "key": "    ╰── 󰹑",
        "format": "{width}x{height} @ {preferred-refresh-rate}hz"
    },


    
    "break",



    {
    "type": "custom",
    "format": "    {#30}████{#31}████{#32}████{#33}████{#34}████{#35}████{#36}████{#37}████"
    },

    "break"

    
  ]
}